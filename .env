# Resource Service DB
RESOURCE_DB_HOST=resource-db
RESOURCE_DB_PORT=5432
RESOURCE_DB_NAME=resource_db
RESOURCE_DB_USER=postgres
RESOURCE_DB_PASSWORD=password
RESOURCE_DB_URL=jdbc:postgresql://resource-db:5432/resource_db

# Resource Service APP
RESOURCE_SERVICE_PORT=8080
RESOURCE_SERVICE_URL=http://resource-service:8080/resources

# Song Service Client
SONG_SERVICE_URL=http://song-service:8081/songs

# LocalStack S3
LOCALSTACK_PORT=4566
S3_SERVICE_URL=http://localstack:4566
S3_SERVICE_REGION=us-east-1
S3_SERVICE_BUCKET=resources
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE=resource-processing-queue

# Song Service DB
SONG_DB_HOST=song-db
SONG_DB_PORT=5433
SONG_DB_NAME=song_db
SONG_DB_USER=postgres
SONG_DB_PASSWORD=password
SONG_DB_URL=jdbc:postgresql://song-db:5432/song_db

# Song Service APP
SONG_SERVICE_PORT=8081

# Eureka Service
EUREKA_SERVICE_PORT=8761
EUREKA_SERVICE_URL=http://eureka-service:8761/eureka/
